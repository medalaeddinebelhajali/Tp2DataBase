      <field><name>pays</name><type>String</type><format/><currency/><decimal/><group/><length>100</length><precision>-1</precision><trim_type>none</trim_type></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI>
      <xloc>112</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
