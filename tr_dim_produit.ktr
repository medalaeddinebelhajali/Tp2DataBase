      <field><name>largeur_std_cm</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>20</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>hauteur_std_cm</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>20</length><precision>-1</precision><trim_type>both</trim_type></field>
    </fields>
