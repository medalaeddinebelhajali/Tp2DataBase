      <field><name>diagonale_pouces</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>20</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>ratio_ecran</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>10</length><precision>-1</precision><trim_type>both</trim_type></field>
