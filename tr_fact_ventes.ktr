        <type>Number</type>
      </value>
      <value>
        <name>ratio_ecran</name>
        <rename>ratio_ecran</rename>
        <default/>
        <type>String</type>
      </value>
      <value>
        <name>longueur_std_cm</name>
        <rename>longueur_std_cm</rename>
        <default/>
        <type>Number</type>
      </value>
      <value>
        <name>largeur_std_cm</name>
        <rename>largeur_std_cm</rename>
        <default/>
        <type>Number</type>
      </value>
      <value>
        <name>hauteur_std_cm</name>
        <rename>hauteur_std_cm</rename>
        <default/>
        <type>Number</type>
      </value>
    </lookup>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI>
      <xloc>624</xloc>
      <yloc>160</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>3. Calculs Metriques, Date YYYYMMDD, RG-01 et RG-02 (JS)</name>
    <type>ScriptValueMod</type>
    <description/>
    <distribute>Y</distribute>
    <custom_distribution/>
    <copies>1</copies>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <compatible>N</compatible>
    <optimizationLevel>9</optimizationLevel>
    <jsScripts>
      <jsScript>
        <jsScript_type>0</jsScript_type>
        <jsScript_name>Script 1</jsScript_name>
        <jsScript_script>// 1. Formatage de la date au format entier YYYYMMDD (id_temps_sk)
var id_temps_sk = parseInt(date_commande.replace(/-/g, ""), 10);

// 2. RG-01 : Normalisation du prix unitaire et depaquetage des Packs
var nbre_packs = quantite;
var pack_size = (qte_par_pack != null &amp;&amp; qte_par_pack > 0) ? qte_par_pack : 1;
var qte_unitaire_totale = nbre_packs * pack_size;
var prix_unitaire_effectif = Math.round((prix_facture / pack_size) * 100) / 100;

// 3. Calculs des metriques financieres
var montant_brut = Math.round((nbre_packs * prix_facture) * 100) / 100;
var montant_remise = Math.round((montant_brut * (remise_pct / 100.0)) * 100) / 100;
var montant_net = Math.round((montant_brut - montant_remise) * 100) / 100;

// 4. RG-02 : Calcul geometrique des dimensions de colis pour la livraison
var colis_longueur_cm = 0.0;
var colis_largeur_cm  = 0.0;
var colis_hauteur_cm  = 0.0;
var colis_volume_cm3  = 0.0;

if (mode_livraison == "LIVRAISON_DOMICILE") {
    if (diagonale_pouces != null &amp;&amp; diagonale_pouces > 0 &amp;&amp; ratio_ecran != null &amp;&amp; ratio_ecran.indexOf("/") != -1) {
        // Cas particulier des Ecrans / Moniteurs
        var parts = ratio_ecran.split("/");
        var num = parseFloat(parts[0]);
        var den = parseFloat(parts[1]);
        var D_cm = diagonale_pouces * 2.54;
        colis_longueur_cm = Math.round((D_cm * Math.sqrt(num / (num + den))) * 100) / 100;
        colis_hauteur_cm  = Math.round((D_cm * Math.sqrt(den / (num + den))) * 100) / 100;
        colis_largeur_cm  = 15.0;
    } else {
        // Produits standards
        colis_longueur_cm = (longueur_std_cm != null) ? longueur_std_cm : 0.0;
        colis_largeur_cm  = (largeur_std_cm != null)  ? largeur_std_cm  : 0.0;
        colis_hauteur_cm  = (hauteur_std_cm != null)  ? hauteur_std_cm  : 0.0;
    }
    colis_volume_cm3 = Math.round((colis_longueur_cm * colis_largeur_cm * colis_hauteur_cm) * 100) / 100;
}
</jsScript_script>
      </jsScript>
    </jsScripts>
    <fields>
      <field><name>id_temps_sk</name><rename>id_temps_sk</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>nbre_packs</name><rename>nbre_packs</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>qte_unitaire_totale</name><rename>qte_unitaire_totale</rename><type>Integer</type><length>9</length><precision>0</precision><replace>N</replace></field>
      <field><name>prix_unitaire_effectif</name><rename>prix_unitaire_effectif</rename><type>Number</type><length>10</length><precision>2</precision><replace>N</replace></field>
      <field><name>montant_brut</name><rename>montant_brut</rename><type>Number</type><length>10</length><precision>2</precision><replace>N</replace></field>
      <field><name>montant_remise</name><rename>montant_remise</rename><type>Number</type><length>10</length><precision>2</precision><replace>N</replace></field>
      <field><name>montant_net</name><rename>montant_net</rename><type>Number</type><length>10</length><precision>2</precision><replace>N</replace></field>
      <field><name>colis_longueur_cm</name><rename>colis_longueur_cm</rename><type>Number</type><length>6</length><precision>2</precision><replace>N</replace></field>
      <field><name>colis_largeur_cm</name><rename>colis_largeur_cm</rename><type>Number</type><length>6</length><precision>2</precision><replace>N</replace></field>
      <field><name>colis_hauteur_cm</name><rename>colis_hauteur_cm</rename><type>Number</type><length>6</length><precision>2</precision><replace>N</replace></field>
      <field><name>colis_volume_cm3</name><rename>colis_volume_cm3</rename><type>Number</type><length>12</length><precision>2</precision><replace>N</replace></field>
    </fields>
    <attributes/>
    <cluster_schema/>
    <remotesteps><input/><output/></remotesteps>
    <GUI>
      <xloc>624</xloc>
      <yloc>304</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
