    <fields>
      <field><name>id_commande</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>50</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>date_commande</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>20</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>client_id</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>50</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>produit_id</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>50</length><precision>-1</precision><trim_type>both</trim_type></field>
      <field><name>quantite</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group>,</group><length>15</length><precision>0</precision><trim_type>both</trim_type></field>
      <field><name>prix_facture</name><type>Number</type><format>#.#</format><currency/><decimal>.</decimal><group>,</group><length>10</length><precision>2</precision><trim_type>both</trim_type></field>
      <field><name>remise_pct</name><type>Number</type><format>#.#</format><currency/><decimal>.</decimal><group>,</group><length>10</length><precision>2</precision><trim_type>both</trim_type></field>
      <field><name>qte_par_pack</name><type>Integer</type><format>#</format><currency/><decimal>.</decimal><group>,</group><length>15</length><precision>0</precision><trim_type>both</trim_type></field>
      <field><name>mode_livraison</name><type>String</type><format/><currency/><decimal>.</decimal><group>,</group><length>50</length><precision>-1</precision><trim_type>both</trim_type></field>
